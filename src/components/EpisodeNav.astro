---
const { prev, next, allSlug } = Astro.props;
---

<div class="episode-nav">
  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td width="33%">
        {prev && <a href={`/watch/${prev}`} class="nav-btn">PREV</a>}
      </td>
      <td width="33%" align="center">
        <a href={`/anime/${allSlug}`} class="nav-btn nav-list">LIST</a>
      </td>
      <td width="33%" align="right">
        {next && <a href={`/watch/${next}`} class="nav-btn">NEXT</a>}
      </td>
    </tr>
  </table>
</div>
